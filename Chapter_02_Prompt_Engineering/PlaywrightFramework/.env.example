# ---------------------------------------------------------------------------
# VWO Login Dashboard - environment configuration
# Copy this file to ".env" and provide the real values. Never commit ".env".
# ---------------------------------------------------------------------------

# Application under test
BASE_URL=https://app.wingify.com/#/login

# Valid credentials (required for the successful-login scenario).
# Leave blank if no verified test account is available; the valid-login
# scenario will be marked as skipped instead of inventing credentials.
VALID_EMAIL=
VALID_PASSWORD=

# Execution behaviour
HEADLESS=false
DEFAULT_TIMEOUT=30000
EXPECT_TIMEOUT=15000
NAVIGATION_TIMEOUT=60000
